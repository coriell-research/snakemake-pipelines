import re
from snakemake.utils import validate


configfile: "config.yaml"
validate(config, "schemas/config.schema.yaml")


RESOURCES_DIR = config["resources_dir"]
SPIKE_INS = config["spike_ins"]
LOG_DIR = "logs"


def basename_of(url):
    return url.rsplit("/", 1)[-1]

DOWNLOADS = {}
def register(path, url):
    DOWNLOADS[path] = url
    return path

DECOMPRESS_MAP = {}
def register_decompress(gz_path):
    plain_path = gz_path[: -len(".gz")]
    DECOMPRESS_MAP[plain_path] = gz_path
    return plain_path


# ---------------------------------------------------------------------------
# Species registry: builds one entry per GENCODE build (human GRCh38, mouse
# GRCm39/M38, mouse GRCm38/M25) from its config block, registering downloads/
# decompressions as it goes. Directory and genome-stem naming is uniform
# across all three builds ("<assembly>.primary_assembly.genome[.fa[.gz]]"
# under "<resources_dir>/<assembly>/GENCODE/<release>/..."), so the index-
# build rules below are written once and parameterized over {assembly}/
# {release} wildcards rather than duplicated per species.
# ---------------------------------------------------------------------------
SPECIES = {}
EXTRA_TARGETS = []  # non-index downloads not shared by all species, e.g. human promoter windows


def build_species(cfg):
    assembly = cfg["assembly"]
    release = cfg["release"]
    urls = cfg["urls"]
    species_dir = f"{RESOURCES_DIR}/{assembly}/GENCODE/{release}"

    genome_fa_gz = register(f"{species_dir}/{basename_of(urls['genome_fa'])}", urls["genome_fa"])
    annotation_gtf_gz = register(f"{species_dir}/{basename_of(urls['annotation_gtf'])}", urls["annotation_gtf"])
    transcripts_fa_gz = register(f"{species_dir}/{basename_of(urls['transcripts_fa'])}", urls["transcripts_fa"])

    for key, url in urls.items():
        if key not in ("genome_fa", "annotation_gtf", "transcripts_fa"):
            EXTRA_TARGETS.append(register(f"{species_dir}/{basename_of(url)}", url))

    register_decompress(register(f"{species_dir}/excluderanges.bed.gz", cfg["excluderanges"]["bed_url"]))

    SPECIES[assembly] = {
        "release": release,
        "dir": species_dir,
        "genome_fa_gz": genome_fa_gz,
        "genome_fa": register_decompress(genome_fa_gz),
        "annotation_gtf": register_decompress(annotation_gtf_gz),
        "transcripts_fa": register_decompress(transcripts_fa_gz),
        "star_sjdb_overhang": cfg["star"]["sjdb_overhang"],
    }


build_species(config["human"])
build_species(config["mouse"]["m38"])
build_species(config["mouse"]["m25"])

wildcard_constraints:
    assembly = "|".join(re.escape(a) for a in SPECIES),
    release = "|".join(re.escape(s["release"]) for s in SPECIES.values())

SPECIES_DIR_T = f"{RESOURCES_DIR}/{{assembly}}/GENCODE/{{release}}"
GENOME_STEM_T = "{assembly}.primary_assembly.genome"
GENOME_FA_T = f"{SPECIES_DIR_T}/{GENOME_STEM_T}.fa"
WITH_SPIKES_FA_T = f"{SPECIES_DIR_T}/{GENOME_STEM_T}.with_spikes.fa"
STAR_IDX_T = f"{SPECIES_DIR_T}/STAR_idx"
BOWTIE2_PREFIX_T = f"{SPECIES_DIR_T}/bt2_idx/{GENOME_STEM_T}"
BWA_MEM2_PREFIX_T = f"{SPECIES_DIR_T}/bwa-mem2_idx/{GENOME_STEM_T}"
SALMON_IDX_T = f"{SPECIES_DIR_T}/salmon_idx"
MINIMAP2_MMI_T = f"{SPECIES_DIR_T}/mm2_idx/{GENOME_STEM_T}.mmi"
BISMARK_IDX_T = f"{SPECIES_DIR_T}/bismark_idx"
BWAMETH_PREFIX_T = f"{SPECIES_DIR_T}/bwa-meth_idx/{GENOME_STEM_T}.fa.gz.bwameth.c2t"
MINIBWA_PREFIX_T = f"{SPECIES_DIR_T}/minibwa_idx/{GENOME_STEM_T}.fa"
EXCLUDERANGES_BED_T = f"{SPECIES_DIR_T}/excluderanges.bed"
CHROM_SIZES_T = f"{SPECIES_DIR_T}/{GENOME_STEM_T}.fa.chrom_sizes"

# ---------------------------------------------------------------------------
# Spike-in / decoy sequences, downloaded from this repo's own
# generate-resources/data/ directory (see config.yaml). ERCC/GFP are used as
# plain FASTA by the index rules below, so they're decompressed like the
# genome/annotation/transcripts; the lambda genome is only ever consumed
# gzipped (by bismark_index/bwameth_index), so it isn't.
# ---------------------------------------------------------------------------
SPIKE_DIR = f"{RESOURCES_DIR}/spike_ins"

ERCC_FA_GZ = register(f"{SPIKE_DIR}/{basename_of(SPIKE_INS['ercc_url'])}", SPIKE_INS["ercc_url"])
GFP_FA_GZ = register(f"{SPIKE_DIR}/{basename_of(SPIKE_INS['gfp_url'])}", SPIKE_INS["gfp_url"])
LAMBDA_FA_GZ = register(f"{SPIKE_DIR}/{basename_of(SPIKE_INS['lambda_url'])}", SPIKE_INS["lambda_url"])

ERCC_FA = register_decompress(ERCC_FA_GZ)
GFP_FA = register_decompress(GFP_FA_GZ)


def expand_species(template):
    return [template.format(assembly=a, release=s["release"]) for a, s in SPECIES.items()]


rule all:
    input:
        expand_species(STAR_IDX_T),
        [expand_species(f"{BOWTIE2_PREFIX_T}{ext}") for ext in (".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2")],
        [expand_species(f"{BWA_MEM2_PREFIX_T}{ext}") for ext in (".0123", ".amb", ".ann", ".bwt.2bit.64", ".pac")],
        expand_species(SALMON_IDX_T),
        expand_species(MINIMAP2_MMI_T),
        expand_species(BISMARK_IDX_T),
        [expand_species(f"{BWAMETH_PREFIX_T}{ext}") for ext in ("", ".0123", ".amb", ".ann", ".bwt.2bit.64", ".pac")],
        [expand_species(f"{MINIBWA_PREFIX_T}{ext}") for ext in (".l2b", ".mbw")],
        expand_species(EXCLUDERANGES_BED_T),
        expand_species(CHROM_SIZES_T),
        EXTRA_TARGETS


rule download:
    output:
        "{path}"
    wildcard_constraints:
        path = "|".join(re.escape(p) for p in DOWNLOADS)
    params:
        url = lambda wildcards: DOWNLOADS[wildcards.path]
    log:
        f"{LOG_DIR}{{path}}.log"
    shell:
        """
        mkdir -p $(dirname {output})
        curl -fL -o {output} {params.url} &> {log}
        """


rule decompress:
    input:
        lambda wildcards: DECOMPRESS_MAP[wildcards.path]
    output:
        temp("{path}")
    wildcard_constraints:
        path = "|".join(re.escape(p) for p in DECOMPRESS_MAP)
    shell:
        "gzip -dc {input} > {output}"


rule combine_with_spikes:
    # STAR/bowtie2/bwa-mem2/minimap2/minibwa indices all include the ERCC
    # spike-ins + GFP construct alongside the primary assembly, for every
    # species.
    input:
        genome = GENOME_FA_T,
        ercc = ERCC_FA,
        gfp = GFP_FA
    output:
        temp(WITH_SPIKES_FA_T)
    shell:
        "cat {input.genome} {input.ercc} {input.gfp} > {output}"


rule star_index:
    input:
        combined = WITH_SPIKES_FA_T,
        gtf = lambda wildcards: SPECIES[wildcards.assembly]["annotation_gtf"]
    output:
        directory(STAR_IDX_T)
    params:
        sjdb_overhang = lambda wildcards: SPECIES[wildcards.assembly]["star_sjdb_overhang"]
    threads:
        config.get("threads", {}).get("star", 32)
    log:
        f"{LOG_DIR}/star_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/star.yaml"
    shell:
        """
        mkdir -p {output}
        STAR --runThreadN {threads} \
            --runMode genomeGenerate \
            --genomeDir {output} \
            --genomeFastaFiles {input.combined} \
            --sjdbGTFfile {input.gtf} \
            --sjdbOverhang {params.sjdb_overhang} &> {log}
        """


rule bowtie2_index:
    input:
        combined = WITH_SPIKES_FA_T
    output:
        [f"{BOWTIE2_PREFIX_T}{ext}" for ext in (".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2")]
    params:
        prefix = BOWTIE2_PREFIX_T
    threads:
        config.get("threads", {}).get("bowtie2", 32)
    log:
        f"{LOG_DIR}/bowtie2_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/bowtie2.yaml"
    shell:
        """
        mkdir -p $(dirname {params.prefix})
        bowtie2-build --threads {threads} {input.combined} {params.prefix} &> {log}
        """


rule bwa_mem2_index:
    input:
        combined = WITH_SPIKES_FA_T
    output:
        [f"{BWA_MEM2_PREFIX_T}{ext}" for ext in (".0123", ".amb", ".ann", ".bwt.2bit.64", ".pac")]
    params:
        prefix = BWA_MEM2_PREFIX_T
    log:
        f"{LOG_DIR}/bwa_mem2_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/bwa-mem2.yaml"
    shell:
        """
        mkdir -p $(dirname {params.prefix})
        bwa-mem2 index -p {params.prefix} {input.combined} &> {log}
        """


rule salmon_index:
    input:
        transcripts = lambda wildcards: SPECIES[wildcards.assembly]["transcripts_fa"],
        genome = GENOME_FA_T,
        ercc = ERCC_FA,
        gfp = GFP_FA
    output:
        directory(SALMON_IDX_T)
    params:
        decoys = f"{SPECIES_DIR_T}/decoys.txt",
        gentrome = f"{SPECIES_DIR_T}/gentrome.fa"
    threads:
        config.get("threads", {}).get("salmon", 32)
    log:
        f"{LOG_DIR}/salmon_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/salmon.yaml"
    shell:
        """
        grep "^>" {input.genome} | cut -d " " -f 1 | sed -e 's/>//g' > {params.decoys}
        cat {input.transcripts} {input.ercc} {input.gfp} {input.genome} > {params.gentrome}
        salmon index -t {params.gentrome} -d {params.decoys} -p {threads} -i {output} --gencode &> {log}
        rm -f {params.decoys} {params.gentrome}
        """


rule minimap2_index:
    input:
        combined = WITH_SPIKES_FA_T
    output:
        MINIMAP2_MMI_T
    log:
        f"{LOG_DIR}/minimap2_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/minimap2.yaml"
    shell:
        """
        mkdir -p $(dirname {output})
        minimap2 -d {output} {input.combined} &> {log}
        """


rule bismark_index:
    input:
        genome = lambda wildcards: SPECIES[wildcards.assembly]["genome_fa_gz"],
        lambda_genome = LAMBDA_FA_GZ
    output:
        directory(BISMARK_IDX_T)
    threads:
        config.get("threads", {}).get("bismark_genome_preparation", 24)
    log:
        f"{LOG_DIR}/bismark_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/bismark.yaml"
    shell:
        """
        mkdir -p {output}
        cat {input.genome} {input.lambda_genome} > {output}/{wildcards.assembly}.primary_assembly.genome.with_lambda.fa.gz
        bismark_genome_preparation --bowtie2 --verbose --genomic_composition --parallel {threads} {output} &> {log}
        """


rule bwameth_index:
    input:
        genome = lambda wildcards: SPECIES[wildcards.assembly]["genome_fa_gz"],
        lambda_genome = LAMBDA_FA_GZ
    output:
        [f"{BWAMETH_PREFIX_T}{ext}" for ext in ("", ".0123", ".amb", ".ann", ".bwt.2bit.64", ".pac")]
    params:
        combined = f"{SPECIES_DIR_T}/bwa-meth_idx/{GENOME_STEM_T}.fa.gz"
    log:
        f"{LOG_DIR}/bwameth_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/bwameth.yaml"
    shell:
        """
        mkdir -p $(dirname {params.combined})
        cat {input.genome} {input.lambda_genome} > {params.combined}
        bwameth.py index-mem2 {params.combined} &> {log}
        """


rule minibwa_index:
    input:
        combined = WITH_SPIKES_FA_T
    output:
        [f"{MINIBWA_PREFIX_T}{ext}" for ext in (".l2b", ".mbw")]
    params:
        prefix = MINIBWA_PREFIX_T
    threads:
        config.get("threads", {}).get("minibwa", 8)
    log:
        f"{LOG_DIR}/minibwa_index/{{assembly}}_{{release}}.log"
    conda:
        "envs/minibwa.yaml"
    shell:
        """
        mkdir -p $(dirname {params.prefix})
        minibwa index -t{threads} {input.combined} {params.prefix} &> {log}
        """


rule chrom_sizes:
    # Since the ERCC + GFP sequences are included in several indices above,
    # they need entries in chrom.sizes too - `faSize -detailed` lists one row
    # per sequence, so running it once against the combined FASTA gives the
    # same result as running it separately per file and concatenating.
    input:
        combined = WITH_SPIKES_FA_T
    output:
        CHROM_SIZES_T
    log:
        f"{LOG_DIR}/chrom_sizes/{{assembly}}_{{release}}.log"
    conda:
        "envs/ucsc.yaml"
    shell:
        "faSize -detailed -tab {input.combined} > {output} 2> {log}"
