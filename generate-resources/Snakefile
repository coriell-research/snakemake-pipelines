rule chrom_sizes:
    # Chromosome sizes for the primary genome only (no spike-in entries).
    input:
        genome = species_file("genome_fa_gz")
    output:
        CHROM_SIZES_T
    log:
        f"{LOG_DIR}/chrom_sizes/{{assembly}}_{{release}}.log"
    conda:
        "envs/ucsc.yaml"
    shell:
        "faSize -detailed -tab {input.genome} > {output} 2> {log}"
