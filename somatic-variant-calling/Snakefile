import os
import re

import pandas as pd
from snakemake.utils import validate


configfile: "config.yaml"

WORK_DIR = "results"
FASTP_OUT = f"{WORK_DIR}/fastp"
BWA_OUT = f"{WORK_DIR}/bwa"
MERGE_OUT = f"{WORK_DIR}/merge"
MARKDUP_OUT = f"{WORK_DIR}/markdup"
PILEUP_SUMMARY_OUT = f"{WORK_DIR}/pileup_summary"
MUTECT_OUT = f"{WORK_DIR}/mutect"
ORIENTATION_MODEL_OUT = f"{WORK_DIR}/orientation_model"
CONTAM_OUT = f"{WORK_DIR}/contamination"
MUSE_PAIRED_OUT = f"{WORK_DIR}/muse_paired"
STRELKA_PAIRED_OUT = f"{WORK_DIR}/strelka_paired"
DEEPSOMATIC_OUT = f"{WORK_DIR}/deepsomatic"
CONSENSUS_OUT = f"{WORK_DIR}/isec"
ANNOTATED_OUT = f"{WORK_DIR}/vep"
CNVKIT_OUT = f"{WORK_DIR}/cnvkit"
SOMATICFREQ_OUT = f"{WORK_DIR}/somaticfreq"
RESOURCES_OUT = f"{WORK_DIR}/resources"

# Samples -----------------------------------------------------------------

# patient/sample forced to string too (not just lane) so purely-numeric IDs
# (e.g. "52647") don't get read as ints and fail the schema's string checks.
SAMPLES = pd.read_csv(
    "samples.csv", sep=",", header=0,
    dtype={"patient": str, "sample": str, "lane": str},
)
validate(SAMPLES, schema="schemas/samples.schema.yaml")

# lanes belonging to each (biological) sample - merged if there is more than one
LANES_BY_SAMPLE = SAMPLES.groupby("sample")["lane"].agg(list).to_dict()

def get_lane_bams(wildcards):
    lanes = LANES_BY_SAMPLE[wildcards.sample]
    return [f"{BWA_OUT}/{wildcards.sample}/{l}.sorted.bam" for l in lanes]

def get_sample_bam_for_dedup(wildcards):
    lanes = LANES_BY_SAMPLE[wildcards.sample]
    if len(lanes) > 1:
        return f"{MERGE_OUT}/{wildcards.sample}.bam"
    return f"{BWA_OUT}/{wildcards.sample}/{lanes[0]}.sorted.bam"

# patient -> {"tumor": sample, "normal": sample or None}
PATIENTS = {}
for patient, group in SAMPLES.groupby("patient"):
    patient = str(patient)
    tumor_samples = group.loc[group["status"] == "tumor", "sample"].unique()
    normal_samples = group.loc[group["status"] == "normal", "sample"].unique()
    if len(tumor_samples) == 0:
        continue
    PATIENTS[patient] = {
        "tumor": tumor_samples[0],
        "normal": normal_samples[0] if len(normal_samples) else None,
    }

PAIRED_PATIENTS = {p: v for p, v in PATIENTS.items() if v["normal"]}
TUMOR_ONLY_PATIENTS = {p: v for p, v in PATIENTS.items() if not v["normal"]}

ALL_SAMPLES = sorted(SAMPLES["sample"].unique())
ALL_NORMAL_SAMPLES = sorted({v["normal"] for v in PAIRED_PATIENTS.values()})
ALL_TUMOR_SAMPLES = sorted({v["tumor"] for v in PATIENTS.values()})


def _alternation_or_no_match(values):
    values = list(values)
    return "|".join(re.escape(v) for v in values) if values else "(?!)"


# Anchors {patient}/{sample} to known IDs: several rules downstream share a
# suffix (e.g. "{patient}.vcf.gz" vs "{patient}.pass.vcf.gz") and wildcards are
# greedy by default, which is ambiguous unless constrained to known IDs.
wildcard_constraints:
    patient = _alternation_or_no_match(PATIENTS.keys()),
    sample = _alternation_or_no_match(ALL_SAMPLES),
    lane = "[^/]+",


# Resource download ------------------------------------------------------
# Downloads every resource this pipeline's config.yaml points at into
# ./resources (relative to this Snakefile, distinct from the pipeline's
# WORK_DIR outputs), so no local absolute paths need to be manually
# specified in config.yaml:
#  - GATK hg38 resource-bundle files, from Broad's public GCS buckets
#    (ref.fasta/fai/dict, ref.bwa_index_prefix's .amb/.ann/.bwt/.pac/.sa,
#    gatk.pon/glr/snps, muse.dbsnp)
#  - Project-specific resources (WES baits, cancer hotspots) committed
#    straight into this repo, fetched via raw.githubusercontent.com
#    (cnvkit.baits, hotspots.path)
#  - The VEP cache, via the bio/vep/cache wrapper (see rule vep_cache below,
#    next to its consumer rule vep_annotate)
# config.yaml points those keys directly at these paths, so any rule needing
# them pulls the corresponding download in automatically - a plain
# `snakemake` run downloads whatever is missing. This pipeline does not
# build its own bwa index (see rule bwa_mem below); it downloads the
# prebuilt one already sitting next to the fasta in the GATK bucket.

DOWNLOAD_DIR = "resources"
VEP_CACHE_OUT = f"{DOWNLOAD_DIR}/vep/cache"
GATK_REF_BUCKET = "https://storage.googleapis.com/gcp-public-data--broad-references/hg38/v0"
GATK_MUTECT_BUCKET = "https://storage.googleapis.com/gatk-best-practices/somatic-hg38"

GATK_RESOURCE_URLS = {
    "Homo_sapiens_assembly38.fasta": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta",
    "Homo_sapiens_assembly38.fasta.fai": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.fai",
    "Homo_sapiens_assembly38.dict": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.dict",
    # ".64" index set - see the comment on rule bwa_mem for why this one and
    # not the bucket's plain (non-.64) .amb/.ann/.bwt/.pac/.sa.
    "Homo_sapiens_assembly38.fasta.64.amb": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.64.amb",
    "Homo_sapiens_assembly38.fasta.64.ann": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.64.ann",
    "Homo_sapiens_assembly38.fasta.64.bwt": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.64.bwt",
    "Homo_sapiens_assembly38.fasta.64.pac": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.64.pac",
    "Homo_sapiens_assembly38.fasta.64.sa": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.fasta.64.sa",
    "Homo_sapiens_assembly38.dbsnp138.vcf.gz": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.dbsnp138.vcf.gz",
    "Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi": f"{GATK_REF_BUCKET}/Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi",
    "1000g_pon.hg38.vcf.gz": f"{GATK_MUTECT_BUCKET}/1000g_pon.hg38.vcf.gz",
    "1000g_pon.hg38.vcf.gz.tbi": f"{GATK_MUTECT_BUCKET}/1000g_pon.hg38.vcf.gz.tbi",
    "af-only-gnomad.hg38.vcf.gz": f"{GATK_MUTECT_BUCKET}/af-only-gnomad.hg38.vcf.gz",
    "af-only-gnomad.hg38.vcf.gz.tbi": f"{GATK_MUTECT_BUCKET}/af-only-gnomad.hg38.vcf.gz.tbi",
    "small_exac_common_3.hg38.vcf.gz": f"{GATK_MUTECT_BUCKET}/small_exac_common_3.hg38.vcf.gz",
    "small_exac_common_3.hg38.vcf.gz.tbi": f"{GATK_MUTECT_BUCKET}/small_exac_common_3.hg38.vcf.gz.tbi",
}

# Files must live (and be committed) at this exact repo path. Update if this
# repo is ever forked/renamed/moved, or these files relocated within it.
REPO_RAW_BASE = "https://raw.githubusercontent.com/coriell-research/snakemake-pipelines/main/somatic-variant-calling/data"

REPO_RESOURCE_URLS = {
    "agilent-sure-select-v6-all-exons_S07604514_Padded.bed.gz": f"{REPO_RAW_BASE}/agilent-sure-select-v6-all-exons_S07604514_Padded.bed.gz",
    "cancerhotspots_v2_GRCh38.tsv": f"{REPO_RAW_BASE}/cancerhotspots_v2_GRCh38.tsv",
}


# Rules ----------------------------------------------------------------------


rule all:
    input:
        expand(f"{ANNOTATED_OUT}/{{patient}}.annotated.vcf.gz", patient=PATIENTS.keys()),
        expand(f"{CNVKIT_OUT}/{{patient}}.call.cns", patient=PATIENTS.keys()),
        expand(f"{SOMATICFREQ_OUT}/{{sample}}.tsv", sample=ALL_TUMOR_SAMPLES),


rule download_gatk_resource:
    output:
        f"{DOWNLOAD_DIR}/{{resource}}"
    wildcard_constraints:
        resource = _alternation_or_no_match(GATK_RESOURCE_URLS.keys())
    params:
        url = lambda w: GATK_RESOURCE_URLS[w.resource]
    log:
        f"{DOWNLOAD_DIR}/{{resource}}.log"
    conda:
        "envs/curl.yaml"
    shell:
        "curl -fsSL --retry 3 --retry-delay 5 -o {output} {params.url} 2> {log}"


# Convenience target to pre-fetch every GATK resource in one go, e.g. ahead
# of submitting cluster jobs: snakemake --cores 1 download_gatk_resources
rule download_gatk_resources:
    input:
        expand(f"{DOWNLOAD_DIR}/{{resource}}", resource=GATK_RESOURCE_URLS.keys())


rule download_repo_resource:
    output:
        f"{DOWNLOAD_DIR}/{{resource}}"
    wildcard_constraints:
        resource = _alternation_or_no_match(REPO_RESOURCE_URLS.keys())
    params:
        url = lambda w: REPO_RESOURCE_URLS[w.resource]
    log:
        f"{DOWNLOAD_DIR}/{{resource}}.log"
    conda:
        "envs/curl.yaml"
    shell:
        "curl -fsSL --retry 3 --retry-delay 5 -o {output} {params.url} 2> {log}"


# Convenience target to pre-fetch every repo resource in one go (unzipped,
# where applicable, so the results are immediately usable).
rule download_repo_resources:
    input:
        expand(f"{DOWNLOAD_DIR}/{{resource}}", resource=REPO_RESOURCE_URLS.keys()),
        f"{DOWNLOAD_DIR}/agilent-sure-select-v6-all-exons_S07604514_Padded.bed",


# The baits BED is stored gzipped in the repo (see REPO_RESOURCE_URLS above);
# cnvkit/DeepSomatic need it decompressed, so it's unzipped right after download.
rule unzip_baits:
    input:
        f"{DOWNLOAD_DIR}/agilent-sure-select-v6-all-exons_S07604514_Padded.bed.gz"
    output:
        f"{DOWNLOAD_DIR}/agilent-sure-select-v6-all-exons_S07604514_Padded.bed"
    shell:
        "gunzip -c {input} > {output}"


# Convenience target to pre-fetch everything (GATK + repo resources + VEP cache) in one go.
rule download_resources:
    input:
        expand(f"{DOWNLOAD_DIR}/{{resource}}", resource=list(GATK_RESOURCE_URLS.keys()) + list(REPO_RESOURCE_URLS.keys())),
        f"{DOWNLOAD_DIR}/agilent-sure-select-v6-all-exons_S07604514_Padded.bed",
        VEP_CACHE_OUT,


rule fastp:
    input:
        r1 = lambda w: SAMPLES.loc[(SAMPLES["sample"] == w.sample) & (SAMPLES["lane"] == w.lane), "read1"].item(),
        r2 = lambda w: SAMPLES.loc[(SAMPLES["sample"] == w.sample) & (SAMPLES["lane"] == w.lane), "read2"].item(),
    output:
        r1_out = temp(f"{FASTP_OUT}/{{sample}}/{{lane}}.trimmed.1.fq.gz"),
        r2_out = temp(f"{FASTP_OUT}/{{sample}}/{{lane}}.trimmed.2.fq.gz"),
        html = f"{FASTP_OUT}/{{sample}}/{{lane}}.fastp.html",
        json = f"{FASTP_OUT}/{{sample}}/{{lane}}.fastp.json"
    log:
        f"{FASTP_OUT}/{{sample}}/{{lane}}.log"
    params:
        extra = config["fastp"]["extra_params"]
    conda:
        "envs/fastp.yaml"
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1_out} -O {output.r2_out} "
        "{params.extra} --html {output.html} --json {output.json} &> {log}"


# bwa mem (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/bwa/mem.html)
# Uses the classic bwa index downloaded alongside ref.fasta from the GATK
# bucket - no index is built by this pipeline. That bucket actually publishes
# two index sets for this fasta: a plain one (.amb/.ann/.bwt/.pac/.sa) and an
# ALT-aware one (.64.amb/.64.ann/.64.bwt/.64.pac/.64.sa, +.64.alt). The plain
# one is a stale/undersized artifact - its .bwt/.sa are a fraction of the
# size a full-genome BWT/SA array needs - and current bwa aborts on it with
# "SA-BWT inconsistency: seq_len is not the same" (confirmed not a bwa
# version issue: 0.7.12 through 0.7.19 all fail on it identically, and its
# MD5s match the bucket exactly, so it isn't a truncated download either).
# config["ref"]["bwa_index_prefix"] therefore points at the ".64" set.
rule bwa_mem:
    input:
        reads = [
            f"{FASTP_OUT}/{{sample}}/{{lane}}.trimmed.1.fq.gz",
            f"{FASTP_OUT}/{{sample}}/{{lane}}.trimmed.2.fq.gz",
        ],
        idx = multiext(config["ref"]["bwa_index_prefix"], ".amb", ".ann", ".bwt", ".pac", ".sa"),
    output:
        f"{BWA_OUT}/{{sample}}/{{lane}}.sorted.bam"
    threads:
        8
    params:
        # Read groups are set directly here from patient/sample/lane, so the
        # separate Picard AddOrReplaceReadGroups step is not needed.
        # PL ILLUMINA is assumed.
        extra = lambda w: f"-R '@RG\\tID:{w.lane}\\tSM:{w.sample}\\tPL:ILLUMINA\\tLB:{w.sample}\\tPU:{w.lane}'",
        sorting = "samtools",
        sort_order = "coordinate",
        sort_extra = "",
    log:
        f"{BWA_OUT}/{{sample}}/{{lane}}.log"
    wrapper:
        "v9.17.1/bio/bwa/mem"


# Picard MergeSamFiles (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/picard/mergesamfiles.html)
# Only requested (via get_sample_bam_for_dedup) for samples with more than one lane 
rule merge_bam:
    input:
        get_lane_bams
    output:
        f"{MERGE_OUT}/{{sample}}.bam"
    threads:
        1
    resources:
        mem_mb = 8192
    params:
        extra = "--ASSUME_SORTED true --SORT_ORDER coordinate",
    log:
        f"{MERGE_OUT}/{{sample}}.log"
    wrapper:
        "v9.17.1/bio/picard/mergesamfiles"


# Picard MarkDuplicates (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/picard/markduplicates.html)
rule mark_duplicates:
    input:
        bams = get_sample_bam_for_dedup
    output:
        bam = f"{MARKDUP_OUT}/{{sample}}.bam",
        metrics = f"{MARKDUP_OUT}/{{sample}}.metrics.txt"
    resources:
        mem_mb = 16384
    params:
        extra = "--ASSUME_SORT_ORDER coordinate",
    log:
        f"{MARKDUP_OUT}/{{sample}}.log"
    wrapper:
        "v9.17.1/bio/picard/markduplicates"


# The markduplicates wrapper does not emit a samtools-style "<bam>.bai" index
# for a plain (non mate-cigar) run; several downstream rules need one.
rule index_markdup_bam:
    input:
        f"{MARKDUP_OUT}/{{sample}}.bam"
    output:
        f"{MARKDUP_OUT}/{{sample}}.bam.bai"
    conda:
        "envs/samtools.yaml"
    shell:
        "samtools index {input}"


# Mutect2 calling/filtering follows the GATK best-practices meta-wrapper
# (https://snakemake-wrappers.readthedocs.io/en/stable/meta-wrappers/bio/gatk_mutect2_calling.html),
# extended to cover both tumor-normal paired and tumor-only patients.
def mutect_bams(wildcards):
    p = PATIENTS[wildcards.patient]
    bams = [f"{MARKDUP_OUT}/{p['tumor']}.bam"]
    if p["normal"]:
        bams.append(f"{MARKDUP_OUT}/{p['normal']}.bam")
    return bams

def mutect_bais(wildcards):
    return [f"{b}.bai" for b in mutect_bams(wildcards)]

def mutect_extra(wildcards, threads):
    p = PATIENTS[wildcards.patient]
    extra = f"--tumor-sample {p['tumor']} "
    if p["normal"]:
        extra += f"--normal-sample {p['normal']} "
    extra += (
        f"--native-pair-hmm-threads {threads} "
        f"--seconds-between-progress-updates {config['mutect']['progress_seconds']}"
    )
    return extra

rule mutect2_call:
    input:
        fasta = config["ref"]["fasta"],
        fasta_fai = config["ref"]["fai"],
        fasta_dict = config["ref"]["dict"],
        map = mutect_bams,
        map_idx = mutect_bais,
        germline = config["gatk"]["glr"],
        germline_tbi = config["gatk"]["glr"] + ".tbi",
        pon = config["gatk"]["pon"],
        pon_tbi = config["gatk"]["pon"] + ".tbi",
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.vcf.gz",
        f1r2 = f"{MUTECT_OUT}/{{patient}}.f1r2.tar.gz",
    threads:
        4
    resources:
        mem_mb = 65536
    params:
        extra = mutect_extra,
    log:
        f"{MUTECT_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/mutect"


rule gatk_get_pileup_summaries:
    input:
        bam = f"{MARKDUP_OUT}/{{sample}}.bam",
        bai = f"{MARKDUP_OUT}/{{sample}}.bam.bai",
        intervals = config["gatk"]["snps"],
        variants = config["gatk"]["snps"],
        variants_tbi = config["gatk"]["snps"] + ".tbi",
    output:
        f"{PILEUP_SUMMARY_OUT}/{{sample}}.table"
    threads:
        1
    resources:
        mem_mb = 8192
    params:
        extra = "--seconds-between-progress-updates 120",
    log:
        f"{PILEUP_SUMMARY_OUT}/{{sample}}.log"
    wrapper:
        "v9.17.1/bio/gatk/getpileupsummaries"


def contamination_inputs(wildcards):
    p = PATIENTS[wildcards.patient]
    inputs = {"tumor": f"{PILEUP_SUMMARY_OUT}/{p['tumor']}.table"}
    if p["normal"]:
        inputs["normal"] = f"{PILEUP_SUMMARY_OUT}/{p['normal']}.table"
    return inputs

rule gatk_calculate_contamination:
    input:
        unpack(contamination_inputs)
    output:
        f"{CONTAM_OUT}/{{patient}}.table"
    threads:
        1
    resources:
        mem_mb = 4096
    params:
        extra = "",
    log:
        f"{CONTAM_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/calculatecontamination"


rule gatk_learn_read_orientation_model:
    input:
        f1r2 = f"{MUTECT_OUT}/{{patient}}.f1r2.tar.gz"
    output:
        f"{ORIENTATION_MODEL_OUT}/{{patient}}.artifacts-prior.tar.gz"
    threads:
        1
    resources:
        mem_mb = 4096
    params:
        extra = "",
    log:
        f"{ORIENTATION_MODEL_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/learnreadorientationmodel"


rule filter_mutect_calls:
    input:
        vcf = f"{MUTECT_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
        ref_dict = config["ref"]["dict"],
        contamination_table = f"{CONTAM_OUT}/{{patient}}.table",
        f1r2 = f"{ORIENTATION_MODEL_OUT}/{{patient}}.artifacts-prior.tar.gz",
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.filtered.vcf.gz"
    resources:
        mem_mb = 8192
    params:
        extra = (
            f"--threshold-strategy {config['mutect']['strategy']} "
            f"--false-discovery-rate {config['mutect']['fdr']} "
            f"--unique-alt-read-count {config['mutect']['alt_reads']} "
            f"--min-median-read-position {config['mutect']['read_pos']} "
            f"--min-median-base-quality {config['mutect']['base_qual']} "
            f"--min-allele-fraction {config['mutect']['min_allele']}"
        ),
        java_opts = "",
    log:
        f"{MUTECT_OUT}/{{patient}}.filter.log"
    wrapper:
        "v9.17.1/bio/gatk/filtermutectcalls"


rule mutect_pass_norm:
    input:
        vcf = f"{MUTECT_OUT}/{{patient}}.filtered.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view --types 'snps' -f 'PASS' {input.vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# MuSE2 - paired only (no tumor-only mode). Modeled on
# https://github.com/wwylab/MuSE/blob/master/MuSE.Snakemake/rules/muse2.smk
rule muse_call:
    input:
        tumor = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam",
        normal = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam",
        tumor_bai = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam.bai",
        normal_bai = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam.bai",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        txt = f"{MUSE_PAIRED_OUT}/{{patient}}.MuSE.txt"
    threads:
        8
    conda:
        "envs/muse.yaml"
    params:
        out_prefix = f"{MUSE_PAIRED_OUT}/{{patient}}"
    log:
        f"{MUSE_PAIRED_OUT}/{{patient}}.call.log"
    shell:
        """
        MuSE call -O {params.out_prefix} -f {input.ref} -n {threads} {input.tumor} {input.normal} 2> {log}
        """


rule muse_sump:
    input:
        txt = f"{MUSE_PAIRED_OUT}/{{patient}}.MuSE.txt",
        dbsnp = config["muse"]["dbsnp"],
        dbsnp_tbi = config["muse"]["dbsnp"] + ".tbi",
    output:
        vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.vcf.gz"
    threads:
        8
    conda:
        "envs/muse.yaml"
    params:
        prefix = f"{MUSE_PAIRED_OUT}/{{patient}}"
    log:
        f"{MUSE_PAIRED_OUT}/{{patient}}.sump.log"
    shell:
        """
        MuSE sump -I {input.txt} -E -n {threads} -O {params.prefix}.vcf -D {input.dbsnp} 2> {log}
        rm -f {output.vcf}
        bgzip {params.prefix}.vcf
        tabix -p vcf {output.vcf}
        """


rule muse_pass_norm:
    input:
        vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{MUSE_PAIRED_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view --types 'snps' -f 'PASS' {input.vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# Strelka2 - paired only, its somatic workflow requires a matched normal
# (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/strelka/somatic.html)

rule strelka_somatic:
    input:
        tumor = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam",
        tumor_index = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam.bai",
        normal = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam",
        normal_index = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam.bai",
        fasta = config["ref"]["fasta"],
        fasta_index = config["ref"]["fai"],
    output:
        directory(f"{STRELKA_PAIRED_OUT}/{{patient}}")
    threads:
        8
    params:
        config_extra = config["strelka"]["config_extra"],
        run_extra = config["strelka"]["run_extra"],
    log:
        f"{STRELKA_PAIRED_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/strelka/somatic"


rule strelka_pass_norm:
    input:
        vcf_dir = f"{STRELKA_PAIRED_OUT}/{{patient}}",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s",
        raw_vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}/results/variants/somatic.snvs.vcf.gz"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view --types 'snps' -f 'PASS' {params.raw_vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# DeepSomatic - runs for both paired and tumor-only patients (unlike
# MuSE2/Strelka2), via singularity since it's only published as a container
# (https://github.com/google/deepsomatic). Model type and --regions follow
# whichever of the 4 linked case studies matches this patient:
#   paired + WES   -> https://github.com/google/deepsomatic/blob/r1.10/docs/deepsomatic-case-study-wes.md            (model_type=WES)
#   paired + WGS   -> https://github.com/google/deepsomatic/blob/r1.10/docs/deepsomatic-case-study-wgs.md            (model_type=WGS)
#   tumor-only WES -> https://github.com/google/deepsomatic/blob/r1.10/docs/deepsomatic-case-study-ffpe-wes-tumor-only.md (model_type=FFPE_WES_TUMOR_ONLY)
#   tumor-only WGS -> https://github.com/google/deepsomatic/blob/r1.10/docs/deepsomatic-case-study-wgs-tumor-only.md      (model_type=WGS_TUMOR_ONLY)
# config["deepsomatic"]["assay_type"] ("WES" or "WGS") picks between them.

def deepsomatic_input_bams(wildcards):
    p = PATIENTS[wildcards.patient]
    files = {
        "tumor": f"{MARKDUP_OUT}/{p['tumor']}.bam",
        "tumor_bai": f"{MARKDUP_OUT}/{p['tumor']}.bam.bai",
    }
    if p["normal"]:
        files["normal"] = f"{MARKDUP_OUT}/{p['normal']}.bam"
        files["normal_bai"] = f"{MARKDUP_OUT}/{p['normal']}.bam.bai"
    return files

def deepsomatic_model_type(wildcards):
    p = PATIENTS[wildcards.patient]
    assay = config["deepsomatic"]["assay_type"]
    if p["normal"]:
        return assay  # "WES" or "WGS"
    return "FFPE_WES_TUMOR_ONLY" if assay == "WES" else "WGS_TUMOR_ONLY"

def deepsomatic_extra(wildcards, input, threads):
    p = PATIENTS[wildcards.patient]
    extra = (
        f"--model_type={deepsomatic_model_type(wildcards)} "
        f"--reads_tumor={input.tumor} "
        f"--sample_name_tumor={p['tumor']} "
        f"--num_shards={threads}"
    )
    if p["normal"]:
        extra += f" --reads_normal={input.normal} --sample_name_normal={p['normal']}"
    else:
        # No matched normal to filter germline/artifact calls against.
        extra += " --use_default_pon_filtering=true"
    if config["deepsomatic"]["assay_type"] == "WES":
        extra += f" --regions={config['cnvkit']['baits']}"
    return extra

# Directories singularity needs to see: the pipeline's working/output tree,
# this Snakefile's own directory (resources/ downloads live there), and
# wherever the WES baits BED lives (may be outside both of the above).
DEEPSOMATIC_BIND_PATHS = sorted({
    os.path.abspath(WORK_DIR),
    os.path.abspath("."),
    os.path.dirname(os.path.abspath(config["cnvkit"]["baits"])),
    "/usr/lib/locale/",
})

rule deepsomatic_call:
    input:
        unpack(deepsomatic_input_bams),
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.vcf.gz"
    threads:
        16
    params:
        extra = deepsomatic_extra,
        bind = " ".join(f"-B {p}" for p in DEEPSOMATIC_BIND_PATHS),
        bin_version = config["deepsomatic"]["bin_version"],
        intermediate_dir = f"{DEEPSOMATIC_OUT}/{{patient}}.intermediate",
        logging_dir = f"{DEEPSOMATIC_OUT}/{{patient}}.logs",
    log:
        f"{DEEPSOMATIC_OUT}/{{patient}}.log"
    shell:
        """
        mkdir -p {params.intermediate_dir} {params.logging_dir}
        singularity run {params.bind} \
            docker://google/deepsomatic:{params.bin_version} \
            run_deepsomatic \
            {params.extra} \
            --ref={input.ref} \
            --output_vcf={output.vcf} \
            --intermediate_results_dir={params.intermediate_dir} \
            --logging_dir={params.logging_dir} &> {log}
        """


rule deepsomatic_pass_norm:
    input:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view --types 'snps' -f 'PASS' {input.vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# Consensus -------------------------------------------------------------------
# Paired patients: sites called PASS by at least config["consensus"]["min_callers_paired"]
# of the 4 callers (Mutect2, MuSE2, Strelka2, DeepSomatic) - defaults to 3/4,
# since most runs of this pipeline are WES tumor-normal pairs and requiring
# unanimous 4/4 agreement was too strict in practice.
# Tumor-only patients: MuSE2/Strelka2 don't run (see their rules above), so
# consensus is between Mutect2 and DeepSomatic only, out of
# config["consensus"]["min_callers_tumor_only"] (defaults to 2/2, i.e. both).
# bcftools isec -n+N means "at least N", so both settings can range from 1
# (union - any caller) up to the number of callers run for that patient
# (intersection - all must agree).

rule consensus_calls_paired:
    input:
        mutect_vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        muse_vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        strelka_vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        deepsomatic_vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
    output:
        vcf = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz",
        tbi = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz.tbi"
    wildcard_constraints:
        patient = _alternation_or_no_match(PAIRED_PATIENTS.keys())
    params:
        prefix_dir = f"{CONSENSUS_OUT}/{{patient}}_isec",
        min_callers = config["consensus"]["min_callers_paired"],
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools isec -c all -n+{params.min_callers} {input.mutect_vcf} {input.muse_vcf} {input.strelka_vcf} {input.deepsomatic_vcf} -p {params.prefix_dir}

        awk 'BEGIN {{OFS="\t"}} {{print $1, $2}}' {params.prefix_dir}/sites.txt > {params.prefix_dir}/regions.txt

        bcftools view -R {params.prefix_dir}/regions.txt -Oz -o {output.vcf} {input.mutect_vcf}
        bcftools index -t {output.vcf}
        """


rule consensus_calls_tumor_only:
    input:
        mutect_vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        deepsomatic_vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
    output:
        vcf = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz",
        tbi = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz.tbi"
    wildcard_constraints:
        patient = _alternation_or_no_match(TUMOR_ONLY_PATIENTS.keys())
    params:
        prefix_dir = f"{CONSENSUS_OUT}/{{patient}}_isec",
        min_callers = config["consensus"]["min_callers_tumor_only"],
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools isec -c all -n+{params.min_callers} {input.mutect_vcf} {input.deepsomatic_vcf} -p {params.prefix_dir}

        awk 'BEGIN {{OFS="\t"}} {{print $1, $2}}' {params.prefix_dir}/sites.txt > {params.prefix_dir}/regions.txt

        bcftools view -R {params.prefix_dir}/regions.txt -Oz -o {output.vcf} {input.mutect_vcf}
        bcftools index -t {output.vcf}
        """


# VEP annotation (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/vep/annotate.html)
# Cache is downloaded via the bio/vep/cache wrapper
# (https://snakemake-wrappers.readthedocs.io/en/stable/wrappers/bio/vep/cache.html)
# into DOWNLOAD_DIR (VEP_CACHE_OUT, defined up in the Resource download
# section), so no local cache path needs to be specified in config.yaml.

rule vep_cache:
    output:
        directory(VEP_CACHE_OUT)
    params:
        species = config["vep"]["species"],
        build = config["vep"]["build"],
        release = config["vep"]["release"],
    log:
        f"{DOWNLOAD_DIR}/vep/cache.log"
    cache:
        "omit-software"
    wrapper:
        "v9.17.1/bio/vep/cache"


rule vep_plugins_dir:
    output:
        directory(f"{RESOURCES_OUT}/vep_plugins")
    shell:
        "mkdir -p {output}"


rule vep_annotate:
    input:
        calls = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz",
        cache = VEP_CACHE_OUT,
        plugins = f"{RESOURCES_OUT}/vep_plugins",
        fasta = config["ref"]["fasta"],
        fai = config["ref"]["fai"],
    output:
        calls = f"{ANNOTATED_OUT}/{{patient}}.annotated.vcf.gz",
        stats = f"{ANNOTATED_OUT}/{{patient}}.stats.html"
    threads:
        4
    params:
        plugins = config["vep"]["plugins"],
        extra = config["vep"]["extra"],
    log:
        f"{ANNOTATED_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/vep/annotate"


# CNVkit (https://cnvkit.readthedocs.io/en/stable/quickstart.html#build-a-reference-from-normal-samples-and-infer-tumor-copy-ratios)
# A single pooled reference is built from all available normals and reused
# for every tumor sample (including tumor-only patients).
# `cnvkit.py batch` already splits the raw baits into target bins and
# generates antitarget bins internally when building a reference (its -t
# accepts the raw, unsplit baits BED, and -a/-g are optional - it calls the
# same `target`/`antitarget` logic itself if they're omitted), so those
# don't need their own rules. Only the access BED is precomputed separately
# here, since it's genome-wide and sample-independent (reused as-is across
# every run), matching CNVkit's own quickstart. The snakemake-wrapper isn't
# used for reference-building because it hard-requires already-split
# target/antitarget file inputs; the per-tumor rule below still uses it
# since it only needs the prebuilt reference.

rule cnvkit_access:
    input:
        fasta = config["ref"]["fasta"],
        fasta_fai = config["ref"]["fai"],
    output:
        f"{RESOURCES_OUT}/access.bed"
    conda:
        "envs/cnvkit.yaml"
    log:
        f"{RESOURCES_OUT}/cnvkit_access.log"
    shell:
        "cnvkit.py access {input.fasta} -o {output} &> {log}"


rule cnvkit_batch_build_reference:
    input:
        bam = expand(f"{MARKDUP_OUT}/{{sample}}.bam", sample=ALL_NORMAL_SAMPLES),
        bai = expand(f"{MARKDUP_OUT}/{{sample}}.bam.bai", sample=ALL_NORMAL_SAMPLES),
        fasta = config["ref"]["fasta"],
        fasta_fai = config["ref"]["fai"],
        baits = config["cnvkit"]["baits"],
        access = f"{RESOURCES_OUT}/access.bed",
    output:
        reference = f"{CNVKIT_OUT}/reference.cnn"
    threads:
        8
    resources:
        mem_mb = 16384
    params:
        method = config["cnvkit"]["method"],
    conda:
        "envs/cnvkit.yaml"
    log:
        f"{CNVKIT_OUT}/reference.log"
    shell:
        "cnvkit.py batch -n {input.bam} -f {input.fasta} -t {input.baits} "
        "-g {input.access} -m {params.method} -p {threads} "
        "--output-reference {output.reference} &> {log}"


rule cnvkit_batch:
    input:
        bam = lambda w: [f"{MARKDUP_OUT}/{PATIENTS[w.patient]['tumor']}.bam"],
        bai = lambda w: [f"{MARKDUP_OUT}/{PATIENTS[w.patient]['tumor']}.bam.bai"],
        reference = f"{CNVKIT_OUT}/reference.cnn",
    output:
        antitarget_coverage = f"{CNVKIT_OUT}/{{patient}}.antitargetcoverage.cnn",
        bins = f"{CNVKIT_OUT}/{{patient}}.bintest.cns",
        regions = f"{CNVKIT_OUT}/{{patient}}.cnr",
        segments = f"{CNVKIT_OUT}/{{patient}}.cns",
        segments_called = f"{CNVKIT_OUT}/{{patient}}.call.cns",
        target_coverage = f"{CNVKIT_OUT}/{{patient}}.targetcoverage.cnn",
    threads:
        4
    resources:
        mem_mb = 8192
    params:
        method = config["cnvkit"]["method"],
        extra = "",
    log:
        f"{CNVKIT_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/cnvkit/batch"


# somaticfreq (https://github.com/PoisonAlien/somaticfreq#usage) - targeted
# VAF/read-count check at known cancer hotspots, run on each tumor BAM.
# Not on conda; expected to already be installed and on PATH. Rather than
# letting a missing binary fail the whole pipeline, the rule checks for it
# first and, if absent, logs a warning and writes empty placeholder outputs
# instead of erroring out.

rule somaticfreq:
    input:
        bam = f"{MARKDUP_OUT}/{{sample}}.bam",
        bai = f"{MARKDUP_OUT}/{{sample}}.bam.bai",
        loci = config["hotspots"]["path"],
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        tsv = f"{SOMATICFREQ_OUT}/{{sample}}.tsv",
        html = f"{SOMATICFREQ_OUT}/{{sample}}.html",
    wildcard_constraints:
        sample = _alternation_or_no_match(ALL_TUMOR_SAMPLES)
    params:
        extra = config["somaticfreq"]["extra"],
        out_prefix = f"{SOMATICFREQ_OUT}/{{sample}}",
    log:
        f"{SOMATICFREQ_OUT}/{{sample}}.log"
    shell:
        """
        if ! command -v somaticfreq >/dev/null 2>&1; then
            echo "WARNING: somaticfreq not found on PATH (https://github.com/PoisonAlien/somaticfreq) - skipping, writing empty placeholder outputs. Install it locally and re-run to enable this rule." > {log}
            touch {output.tsv} {output.html}
            exit 0
        fi
        somaticfreq {params.extra} -f {input.ref} -o {params.out_prefix} {input.loci} {input.bam} &> {log}
        """
