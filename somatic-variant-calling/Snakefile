            bed = f"{MOSDEPTH_OUT}/{{sample}}.regions.bed.gz",
            summary = f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.summary.txt",
        threads:
            4
        params:
            extra = config["mosdepth"]["extra"],
        log:
            f"{MOSDEPTH_OUT}/{{sample}}.log"
        wrapper:
            "v9.17.1/bio/mosdepth"
else:
    rule mosdepth:
        input:
            bam = f"{MARKDUP_OUT}/{{sample}}.bam",
            bai = f"{MARKDUP_OUT}/{{sample}}.bam.bai",
        output:
            dist = f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.global.dist.txt",
            per_base = f"{MOSDEPTH_OUT}/{{sample}}.per-base.bed.gz",
            summary = f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.summary.txt",
        threads:
            4
        params:
            extra = config["mosdepth"]["extra"],
        log:
            f"{MOSDEPTH_OUT}/{{sample}}.log"
        wrapper:
            "v9.17.1/bio/mosdepth"


def mutect_bams(wildcards):
    p = PATIENTS[wildcards.patient]
    bams = [f"{MARKDUP_OUT}/{p['tumor']}.bam"]
    if p["normal"]:
        bams.append(f"{MARKDUP_OUT}/{p['normal']}.bam")
    return bams

def mutect_bais(wildcards):
    return [f"{b}.bai" for b in mutect_bams(wildcards)]

def mutect_extra(wildcards):
    p = PATIENTS[wildcards.patient]
    extra = f"--tumor-sample {p['tumor']} "
    if p["normal"]:
        extra += f"--normal-sample {p['normal']} "
    extra += f"--seconds-between-progress-updates {config['mutect']['progress_seconds']}"
    return extra


rule mutect2_call:
    input:
        fasta = config["ref"]["fasta"],
        fasta_fai = config["ref"]["fai"],
        fasta_dict = config["ref"]["dict"],
        map = mutect_bams,
        map_idx = mutect_bais,
        germline = config["gatk"]["glr"],
        germline_tbi = config["gatk"]["glr"] + ".tbi",
        pon = config["gatk"]["pon"],
        pon_tbi = config["gatk"]["pon"] + ".tbi",
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.vcf.gz",
        f1r2 = f"{MUTECT_OUT}/{{patient}}.f1r2.tar.gz",
    threads:
        4
    resources:
        mem_mb = 65536
    params:
        extra = mutect_extra,
    log:
        f"{MUTECT_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/mutect"


rule gatk_get_pileup_summaries:
    input:
        bam = f"{MARKDUP_OUT}/{{sample}}.bam",
        bai = f"{MARKDUP_OUT}/{{sample}}.bam.bai",
        intervals = config["gatk"]["snps"],
        variants = config["gatk"]["snps"],
        variants_tbi = config["gatk"]["snps"] + ".tbi",
    output:
        f"{PILEUP_SUMMARY_OUT}/{{sample}}.table"
    threads:
        1
    resources:
        mem_mb = 8192
    params:
        extra = "--seconds-between-progress-updates 120",
    log:
        f"{PILEUP_SUMMARY_OUT}/{{sample}}.log"
    wrapper:
        "v9.17.1/bio/gatk/getpileupsummaries"


def contamination_inputs(wildcards):
    p = PATIENTS[wildcards.patient]
    inputs = {"tumor": f"{PILEUP_SUMMARY_OUT}/{p['tumor']}.table"}
    if p["normal"]:
        inputs["normal"] = f"{PILEUP_SUMMARY_OUT}/{p['normal']}.table"
    return inputs


rule gatk_calculate_contamination:
    input:
        unpack(contamination_inputs)
    output:
        f"{CONTAM_OUT}/{{patient}}.table"
    threads:
        1
    resources:
        mem_mb = 4096
    params:
        extra = "",
    log:
        f"{CONTAM_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/calculatecontamination"


rule gatk_learn_read_orientation_model:
    input:
        f1r2 = f"{MUTECT_OUT}/{{patient}}.f1r2.tar.gz"
    output:
        f"{ORIENTATION_MODEL_OUT}/{{patient}}.artifacts-prior.tar.gz"
    threads:
        1
    resources:
        mem_mb = 4096
    params:
        extra = "",
    log:
        f"{ORIENTATION_MODEL_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/gatk/learnreadorientationmodel"


rule filter_mutect_calls:
    input:
        vcf = f"{MUTECT_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
        ref_dict = config["ref"]["dict"],
        contamination_table = f"{CONTAM_OUT}/{{patient}}.table",
        f1r2 = f"{ORIENTATION_MODEL_OUT}/{{patient}}.artifacts-prior.tar.gz",
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.filtered.vcf.gz"
    resources:
        mem_mb = 8192
    params:
        java_opts = "",
    log:
        f"{MUTECT_OUT}/{{patient}}.filter.log"
    wrapper:
        "v9.17.1/bio/gatk/filtermutectcalls"


rule mutect_pass_norm:
    input:
        vcf = f"{MUTECT_OUT}/{{patient}}.filtered.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view -f 'PASS' {input.vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


rule muse:
    input:
        tumor = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam",
        normal = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam",
        tumor_bai = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam.bai",
        normal_bai = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam.bai",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
        dbsnp = config["muse"]["dbsnp"],
        dbsnp_tbi = config["muse"]["dbsnp"] + ".tbi",
    output:
        vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.vcf.gz",
        tbi = f"{MUSE_PAIRED_OUT}/{{patient}}.vcf.gz.tbi"
    threads:
        8
    conda:
        "envs/muse.yaml"
    params:
        call_prefix = f"{MUSE_PAIRED_OUT}/{{patient}}",
        work_prefix = f"{MUSE_PAIRED_OUT}/{{patient}}.tmp",
    log:
        f"{MUSE_PAIRED_OUT}/{{patient}}.log"
    shell:
        """
        MuSE call -O {params.call_prefix} -f {input.ref} -n {threads} {input.tumor} {input.normal} 2> {log}
        touch {input.dbsnp_tbi}
        MuSE sump -I {params.call_prefix}.MuSE.txt -E -n {threads} -O {params.work_prefix}.vcf -D {input.dbsnp} 2>> {log}
        bgzip {params.work_prefix}.vcf
        tabix -p vcf {params.work_prefix}.vcf.gz
        mv {params.work_prefix}.vcf.gz {output.vcf}
        mv {params.work_prefix}.vcf.gz.tbi {output.tbi}
        rm -f {params.call_prefix}.MuSE.txt
        """


rule muse_pass_norm:
    input:
        vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
