        """


rule strelka_somatic:
    input:
        tumor = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam",
        tumor_index = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['tumor']}.bam.bai",
        normal = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam",
        normal_index = lambda w: f"{MARKDUP_OUT}/{PAIRED_PATIENTS[w.patient]['normal']}.bam.bai",
        fasta = config["ref"]["fasta"],
        fasta_index = config["ref"]["fai"],
    output:
        directory(f"{STRELKA_PAIRED_OUT}/{{patient}}")
    threads:
        8
    params:
        config_extra = config["strelka"]["config_extra"],
        run_extra = config["strelka"]["run_extra"],
    log:
        f"{STRELKA_PAIRED_OUT}/{{patient}}.log"
    wrapper:
        "v9.17.1/bio/strelka/somatic"


rule strelka_pass_norm:
    input:
        vcf_dir = f"{STRELKA_PAIRED_OUT}/{{patient}}",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s",
        raw_vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}/results/variants/somatic.snvs.vcf.gz"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view -f 'PASS' {params.raw_vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# DeepSomatic - runs for both paired and tumor-only patients via singularity since 
# it's only published as a container (https://github.com/google/deepsomatic).
def deepsomatic_input_bams(wildcards):
    p = PATIENTS[wildcards.patient]
    files = {
        "tumor": f"{MARKDUP_OUT}/{p['tumor']}.bam",
        "tumor_bai": f"{MARKDUP_OUT}/{p['tumor']}.bam.bai",
    }
    if p["normal"]:
        files["normal"] = f"{MARKDUP_OUT}/{p['normal']}.bam"
        files["normal_bai"] = f"{MARKDUP_OUT}/{p['normal']}.bam.bai"
    return files

def deepsomatic_model_type(wildcards):
    p = PATIENTS[wildcards.patient]
    assay = config["deepsomatic"]["assay_type"]
    if p["normal"]:
        return assay  # "WES" or "WGS"
    return "FFPE_WES_TUMOR_ONLY" if assay == "WES" else "WGS_TUMOR_ONLY"

def deepsomatic_extra(wildcards, input, threads):
    p = PATIENTS[wildcards.patient]
    extra = (
        f"--model_type={deepsomatic_model_type(wildcards)} "
        f"--reads_tumor={input.tumor} "
        f"--sample_name_tumor={p['tumor']} "
        f"--num_shards={threads}"
    )
    if p["normal"]:
        extra += f" --reads_normal={input.normal} --sample_name_normal={p['normal']}"
    else:
        # No matched normal to filter germline/artifact calls against.
        extra += " --use_default_pon_filtering=true"
    if config["deepsomatic"]["assay_type"] == "WES":
        extra += f" --regions={config['cnvkit']['baits']}"
    return extra


DEEPSOMATIC_SCRIPTS_DIR = os.path.abspath(".")

DEEPSOMATIC_BIND_PATHS = sorted({
    os.path.abspath(WORK_DIR),
    DEEPSOMATIC_SCRIPTS_DIR,
    os.path.dirname(os.path.abspath(config["cnvkit"]["baits"])),
    "/usr/lib/locale/",
})

rule deepsomatic_call:
    input:
        unpack(deepsomatic_input_bams),
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.vcf.gz"
    threads:
        16
    params:
        extra = deepsomatic_extra,
        bind = " ".join(f"-B {p}" for p in DEEPSOMATIC_BIND_PATHS),
        bin_version = config["deepsomatic"]["bin_version"],
        intermediate_dir = f"{DEEPSOMATIC_OUT}/{{patient}}.intermediate",
        logging_dir = f"{DEEPSOMATIC_OUT}/{{patient}}.logs",
        pwd = DEEPSOMATIC_SCRIPTS_DIR,
    log:
        f"{DEEPSOMATIC_OUT}/{{patient}}.log"
    shell:
        """
        mkdir -p {params.intermediate_dir} {params.logging_dir}
        singularity run --no-home --pwd {params.pwd} {params.bind} \
            docker://google/deepsomatic:{params.bin_version} \
            run_deepsomatic \
            {params.extra} \
            --ref={input.ref} \
            --output_vcf={output.vcf} \
            --intermediate_results_dir={params.intermediate_dir} \
            --logging_dir={params.logging_dir} &> {log}
        """


rule deepsomatic_pass_norm:
    input:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.vcf.gz",
        ref = config["ref"]["fasta"],
        ref_fai = config["ref"]["fai"],
    output:
        vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
        tbi = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz.tbi"
    params:
        buff = 10000,
        multi_allele = "-",
        check_ref = "s"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools view -f 'PASS' {input.vcf} | \
        bcftools norm -c {params.check_ref} -m {params.multi_allele} -w {params.buff} -f {input.ref} | \
        bcftools view -Oz -o {output.vcf} && \
        bcftools index -t {output.vcf}
        """


# Consensus -------------------------------------------------------------------


rule consensus_calls_paired:
    input:
        mutect_vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        muse_vcf = f"{MUSE_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        strelka_vcf = f"{STRELKA_PAIRED_OUT}/{{patient}}.pass.vcf.gz",
        deepsomatic_vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
    output:
        vcf = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz",
        tbi = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz.tbi"
    wildcard_constraints:
        patient = _alternation_or_no_match(PAIRED_PATIENTS.keys())
    params:
        prefix_dir = f"{CONSENSUS_OUT}/{{patient}}_isec",
        min_callers = config["consensus"]["min_callers_paired"],
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools isec -c all -n+{params.min_callers} {input.mutect_vcf} {input.muse_vcf} {input.strelka_vcf} {input.deepsomatic_vcf} -p {params.prefix_dir}

        awk 'BEGIN {{OFS="\t"}} {{print $1, $2}}' {params.prefix_dir}/sites.txt > {params.prefix_dir}/regions.txt

        bcftools view -R {params.prefix_dir}/regions.txt -Oz -o {output.vcf} {input.mutect_vcf}
        bcftools index -t {output.vcf}
        """


rule consensus_calls_tumor_only:
    input:
        mutect_vcf = f"{MUTECT_OUT}/{{patient}}.pass.vcf.gz",
        deepsomatic_vcf = f"{DEEPSOMATIC_OUT}/{{patient}}.pass.vcf.gz",
    output:
        vcf = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz",
        tbi = f"{CONSENSUS_OUT}/{{patient}}.vcf.gz.tbi"
    wildcard_constraints:
        patient = _alternation_or_no_match(TUMOR_ONLY_PATIENTS.keys())
    params:
        prefix_dir = f"{CONSENSUS_OUT}/{{patient}}_isec",
        min_callers = config["consensus"]["min_callers_tumor_only"],
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools isec -c all -n+{params.min_callers} {input.mutect_vcf} {input.deepsomatic_vcf} -p {params.prefix_dir}

        awk 'BEGIN {{OFS="\t"}} {{print $1, $2}}' {params.prefix_dir}/sites.txt > {params.prefix_dir}/regions.txt

        bcftools view -R {params.prefix_dir}/regions.txt -Oz -o {output.vcf} {input.mutect_vcf}
        bcftools index -t {output.vcf}
        """


