import os
import pandas as pd
from snakemake.exceptions import WorkflowError
from snakemake.utils import validate

configfile: "config.yaml"
validate(config, "schemas/config.schema.yaml")


LANES = pd.read_csv("samples.csv", sep=",")
validate(LANES, "schemas/samples.schema.yaml")

LANE_KEY_COLS = ["sample_name", "read1", "read2"]
if LANES.duplicated(subset=LANE_KEY_COLS).any():
    dupes = LANES.loc[LANES.duplicated(subset=LANE_KEY_COLS), LANE_KEY_COLS].to_dict("records")
    raise WorkflowError(
        f"Duplicate lane entries in samples.csv (identical sample_name/read1/read2): {dupes}"
    )

for _, row in LANES.iterrows():
    for col in ("read1", "read2"):
        if not os.path.isfile(row[col]):
            raise WorkflowError(f"{col} for sample '{row['sample_name']}' not found: {row[col]}")

# one or more rows per sample_name are allowed (one row per lane); lanes are
# merged per-sample by rule merge_lanes before any trimming/alignment happens.
# samples with only one lane skip merge_lanes entirely (see fastp_input below).
SAMPLES_LIST = LANES["sample_name"].drop_duplicates().tolist()
LANE_R1 = LANES.groupby("sample_name")["read1"].apply(list).to_dict()
LANE_R2 = LANES.groupby("sample_name")["read2"].apply(list).to_dict()

WORK_DIR = config.get("work_dir", "../data")
MERGED_OUT = f"{WORK_DIR}/merged"
FASTP_OUT = f"{WORK_DIR}/fastp"
STAR_OUT = f"{WORK_DIR}/star"
SALMON_OUT = f"{WORK_DIR}/salmon"
MOSDEPTH_OUT = f"{WORK_DIR}/mosdepth"
RUSTQC_OUT = f"{WORK_DIR}/rustqc"
MULTIQC_OUT = f"{WORK_DIR}/multiqc"
LOG_DIR = f"{WORK_DIR}/logs"


def fastp_input(lane_paths, mate):
    def _input(wildcards):
        sample_lanes = lane_paths[wildcards.sample]
        if len(sample_lanes) == 1:
            return sample_lanes[0]
        return f"{MERGED_OUT}/{wildcards.sample}.merged.{mate}.fq.gz"

    return _input


rule all:
    input:
        f"{MULTIQC_OUT}/multiqc_report.html"


rule merge_lanes:
    input:
        r1 = lambda w: LANE_R1[w.sample],
        r2 = lambda w: LANE_R2[w.sample]
    output:
        r1_out = temp(f"{MERGED_OUT}/{{sample}}.merged.1.fq.gz"),
        r2_out = temp(f"{MERGED_OUT}/{{sample}}.merged.2.fq.gz")
    log:
        f"{LOG_DIR}/merge_lanes/{{sample}}.log"
    shell:
        """
        cat {input.r1} > {output.r1_out} 2> {log}
        cat {input.r2} > {output.r2_out} 2>> {log}
        """


rule fastp:
    input:
        r1 = fastp_input(LANE_R1, 1),
        r2 = fastp_input(LANE_R2, 2)
    output:
        r1_out = temp(f"{FASTP_OUT}/{{sample}}.trimmed.1.fq.gz"),
        r2_out = temp(f"{FASTP_OUT}/{{sample}}.trimmed.2.fq.gz"),
        html = f"{FASTP_OUT}/{{sample}}.fastp.html",
        json = f"{FASTP_OUT}/{{sample}}.fastp.json"
    log:
        f"{LOG_DIR}/fastp/{{sample}}.log"
    params:
        extra = config["fastp"]["extra_params"]
    threads:
        config.get("fastp", {}).get("threads", 8)
    conda:
        "envs/fastp.yaml"
    shell:
        """
        fastp -i {input.r1} \
              -I {input.r2} \
              -o {output.r1_out} \
              -O {output.r2_out} \
              --thread {threads} \
              {params.extra} \
              --html {output.html} \
              --json {output.json} &> {log}
        """


rule star:
    priority: 50
    input:
        r1 = f"{FASTP_OUT}/{{sample}}.trimmed.1.fq.gz",
        r2 = f"{FASTP_OUT}/{{sample}}.trimmed.2.fq.gz"
    output:
        bam = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam",
        bai = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam.bai",
        log_final = f"{STAR_OUT}/{{sample}}.Log.final.out"
    log:
        f"{LOG_DIR}/star/{{sample}}.log"
    threads: 
        config.get("star", {}).get("threads", 12)
    params:
        star_index = config["star"]["index_dir"],
        out_prefix = f"{STAR_OUT}/{{sample}}.",
        extra = config["star"]["extra_params"]
    conda:
        "envs/star.yaml"
    shell:
        """
        # conda STAR build may use CPU instructions this machine lacks (e.g. illegal instruction);
        # fall back to the local binary if it cannot even print its version
        STAR_BIN=STAR
        if ! STAR --version &> /dev/null; then
            echo "conda STAR failed to run, falling back to /usr/local/bin/STAR" > {log}
            STAR_BIN=/usr/local/bin/STAR
        fi

        $STAR_BIN --genomeDir {params.star_index} \
          --readFilesIn {input.r1} {input.r2} \
          --readFilesCommand zcat \
          --outFileNamePrefix {params.out_prefix} \
          --runThreadN {threads} \
          --quantMode GeneCounts \
          --outSAMtype BAM SortedByCoordinate \
          {params.extra} &>> {log}
        
        samtools index {output.bam}
        """


rule salmon:
    priority: 50
    input:
        r1 = f"{FASTP_OUT}/{{sample}}.trimmed.1.fq.gz",
        r2 = f"{FASTP_OUT}/{{sample}}.trimmed.2.fq.gz"
    output:
        quant_sf = f"{SALMON_OUT}/{{sample}}/quant.sf"
    log:
        f"{LOG_DIR}/salmon/{{sample}}.log"
    params:
        salmon_index = config["salmon"]["index_dir"],
        extra = config["salmon"]["extra_params"],
        lib_type = config["salmon"]["lib_type"],
        gibbs = config["salmon"]["gibbs"],
        output_dir = f"{SALMON_OUT}/{{sample}}"
    threads:
        config.get("salmon", {}).get("threads", 8)
    conda:
        "envs/salmon.yaml"
    shell:
        """
        salmon quant \
          --index {params.salmon_index} \
          --libType {params.lib_type} \
          --mates1 {input.r1} \
          --mates2 {input.r2} \
          --threads {threads} \
          --numGibbsSamples {params.gibbs} \
          --output {params.output_dir} {params.extra} &>> {log}
        """


rule mosdepth:
    input:
        bam = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam",
        bai = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam.bai"
    output:
        dist = f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.global.dist.txt",
        summary = f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.summary.txt",
        regions = f"{MOSDEPTH_OUT}/{{sample}}.regions.bed.gz"
    params:
        prefix = f"{MOSDEPTH_OUT}/{{sample}}",
        window = config["mosdepth"]["window_size"],
        include_flag = config["mosdepth"]["include_flag"], 
        extra_params = config["mosdepth"]["extra_params"]
    log:
        f"{LOG_DIR}/mosdepth/{{sample}}.log"
    threads:
        config.get("mosdepth", {}).get("threads", 4)
    conda:
        "envs/mosdepth.yaml"
    shell:
        """
        mosdepth \
          --threads {threads} \
          --by {params.window} \
          --include-flag {params.include_flag} \
          {params.extra_params} \
          {params.prefix} \
          {input.bam} &> {log}
        """


rule rustqc:
    input:
        bam = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam",
        bai = f"{STAR_OUT}/{{sample}}.Aligned.sortedByCoord.out.bam.bai"
    output:
        json = f"{RUSTQC_OUT}/{{sample}}/{{sample}}_summary.json"
    params:
        gtf = config["rustqc"]["gtf"],
        biotype = config["rustqc"]["biotype"],
        stranded = config["rustqc"]["stranded"],
        outdir = f"{RUSTQC_OUT}/{{sample}}"
    log:
        f"{LOG_DIR}/rustqc/{{sample}}.log"
    threads:
        config.get("rustqc", {}).get("threads", 4)
    conda:
        "envs/rustqc.yaml"
    shell:
        """
        rustqc rna {input.bam} \
          --gtf {params.gtf} \
          --sample-name {wildcards.sample} \
          --json-summary {output.json} \
          --stranded {params.stranded} \
          --paired \
          --skip-dup-check \
          --biotype-attribute {params.biotype} \
          --threads {threads} \
          --outdir {params.outdir} &> {log}
        """


rule multiqc_report:
    input:
        expand(f"{FASTP_OUT}/{{sample}}.fastp.html", sample=SAMPLES_LIST),
        expand(f"{STAR_OUT}/{{sample}}.Log.final.out", sample=SAMPLES_LIST),
        expand(f"{SALMON_OUT}/{{sample}}/quant.sf", sample=SAMPLES_LIST),
        expand(f"{MOSDEPTH_OUT}/{{sample}}.mosdepth.summary.txt", sample=SAMPLES_LIST),
        expand(f"{RUSTQC_OUT}/{{sample}}/{{sample}}_summary.json", sample=SAMPLES_LIST)
    output:
        html_report = f"{MULTIQC_OUT}/multiqc_report.html",
        data_dir = directory(f"{MULTIQC_OUT}/multiqc_data")
    log:
        f"{LOG_DIR}/multiqc/multiqc.log"
    params:
        search_dirs = f"{FASTP_OUT} {STAR_OUT} {SALMON_OUT} {MOSDEPTH_OUT} {RUSTQC_OUT}",
        output_dir = MULTIQC_OUT
    conda:
        "envs/multiqc.yaml"
    shell:
        "multiqc --force {params.search_dirs} -o {params.output_dir} &> {log}"